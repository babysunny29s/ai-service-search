# Serper.dev key — only read by the Serper MCP server process
SERPER_API_KEY=

# Scrape Creators key for public profiles (Facebook, Instagram, TikTok, X, LinkedIn, Threads).
# Dashboard: https://app.scrapecreators.com — docs: https://docs.scrapecreators.com
# 1 credit per live profile read. CRAWLFEED_KEY is still accepted as an alias.
SCRAPECREATORS_API_KEY=
# Profile reads. Default 30s (FETCH_TIMEOUT_S is only for HTML pages).
SCRAPECREATORS_TIMEOUT_S=30

# LLM provider (OpenAI-compatible endpoint, e.g. Yescale)
LLM_BASE_URL=https://api.yescale.io/v1
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=60
LLM_TEMPERATURE=0.1
# Thinking budget: none | low | medium | high (empty = provider default). Thinking tokens are billed as output.
LLM_REASONING_EFFORT=low
# Language for headline / disambiguationNote / occupation / knownFor (imageSearchQuery is always English)
OUTPUT_LANGUAGE=English

# Langfuse tracing (optional): one trace per search with the LLM calls, searches and page fetches.
# Leave the keys empty to disable. Base URL: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US) or a self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Yescale bill: tokens * $/1M → credit; VND = credit * top-up rate.
# Example: 1052 in * 0.75 + 114 out * 3.75 → 0.001216 credit × 8000 = 9.73 ₫
LLM_PRICE_INPUT_PER_1M=0.75
LLM_PRICE_OUTPUT_PER_1M=3.75
LLM_GROUP_RATIO=1.0
YESCALE_VND_PER_CREDIT=8000
# Unit prices in VND (0 = omit). Serper: 1 search credit/token. Scrape Creators: 1 credit.
SERPER_PRICE_PER_SEARCH=26
SCRAPECREATORS_PRICE_PER_CREDIT=49
COST_CURRENCY=VND

# MCP servers config file
MCP_CONFIG_PATH=mcp_servers.json

# Job limits
# Discovery: query 1 is "name"; the rest only run when no knowledge panel was found
MAX_QUERIES=2
RESULTS_PER_QUERY=10
MAX_FETCH_URLS=4
# LLM input budget (one analyze call per round)
MAX_LLM_SOURCES=20
EXCERPT_CHARS=2000
# Enrichment: only for candidates with fewer than ENRICH_MIN_IDENTIFYING attributes and no wiki/knowledge panel
ENRICH_CANDIDATES=2
ENRICH_QUERIES_PER_CANDIDATE=1
ENRICH_FETCH_URLS=3
ENRICH_MIN_IDENTIFYING=3
ENRICH_IMAGES=false
FETCH_TIMEOUT_S=10
# Wikipedia/Wikimedia require "Name/version (contact URL or email) lib/version"; put your real contact here
FETCH_USER_AGENT="ProfileSearchBot/0.1 (+https://example.com/bot) httpx"
FETCH_MAX_BYTES=1500000
JOB_TIMEOUT_S=120
SYNC_TIMEOUT_S=60
SEARCH_CACHE_TTL_S=900
# Whole-result cache per (name, filters)
RESULT_CACHE_TTL_S=21600
# Default search locale. A location/nationality filter, or a Vietnamese-spelled name (vn/vi),
# overrides it. Only the search is local; everything returned is in OUTPUT_LANGUAGE.
SEARCH_LOCALE_GL=us
SEARCH_LOCALE_HL=en

# Extra social-profile lookup (1 search call per candidate)
SOCIAL_LOOKUP_CANDIDATES=2
SOCIAL_MIN_PLATFORMS=3

# llm_first: ask the LLM first, search only for what it does not know | search_first: always search
SEARCH_STRATEGY=llm_first
# LLM calls per search. 1 = search, then a single analysis call (llm_first needs 2; enrichment
# rounds need an extra call, so both are skipped at 1).
LLM_MAX_CALLS=1

# Photos must show the person: face check with OpenCV (models auto-download to FACE_MODEL_DIR).
FACE_VERIFY=true
FACE_MODEL_DIR=models
FACE_MATCH_THRESHOLD=0.363
# A face belongs to one candidate: when two share a reference face (similarity >= this), only the one
# with the most photos of it keeps those photos (0 = off).
FACE_SHARED_THRESHOLD=0.55
# People returned per search (the LLM is asked for at most this many).
MAX_CANDIDATES=15
# People always need a search-found source; true = also hide people without a face-checked photo.
REQUIRE_SOURCE=true
REQUIRE_PHOTO=false

# RabbitMQ worker: uv run python -m app.worker
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_CONSUMER_TIMEOUT=300
SEARCH_QUEUE_REQUEST=AI_SEARCH_QUEUE_IN
SEARCH_REQUEST_EXCHANGE=AI_SEARCH_EXCHANGE_INPUT
SEARCH_RESULT_QUEUE=AI_SEARCH_QUEUE_OUT
SEARCH_RESULT_EXCHANGE=AI_SEARCH_EXCHANGE_RESULT
SEARCH_WORKFLOW=process_search

# MinIO: queue field `image` is a MinIO URL; worker downloads the file
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=ai-inhouse
MINIO_SECURE=true
MINIO_SEARCH_FOLDER=search

# Postgres onesearch: SearchHistory.id = client searchId, Candidate.id = cnd_…,
# ChatSession.id = client sessionId, ChatHistory.id = msg_…. No schema changes.
DB_HOST=
DB_PORT=5432
DB_NAME=onesearch
DB_USER=
DB_PASSWORD=

# Search history + chat about a saved candidate (SQLite, relative to the project root).
HISTORY_DB_PATH=data/history.db
# Previous turns resent with each question, and the characters kept per message.
CHAT_MAX_TURNS=4
CHAT_TURN_CHARS=280
# The model answers from what it knows and calls web search only when it does not:
# searches allowed per question (0 = never search), results kept per search.
CHAT_MAX_SEARCHES=2
CHAT_SEARCH_RESULTS=5
# Result pages read in full when the model searches (passages around the name; 0 = snippets only).
CHAT_FETCH_PAGES=3
CHAT_PAGE_CHARS=1500
CHAT_FETCH_TIMEOUT_S=6
CHAT_MAX_TOKENS=800

# Photos per person in a search result; more come from POST /v1/photos on demand.
INITIAL_PHOTOS=1
MORE_PHOTOS_MAX=12
